#!/bin/sh
# Builds, tests, and installs Oma Spend for the current user, so it needs no
# sudo: the binary goes to ~/.local/bin and the launcher entry and icon to
# ~/.local/share, which the Omarchy launcher reads.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
BIN="$HOME/.local/bin"
SHARE="${XDG_DATA_HOME:-$HOME/.local/share}"

"$ROOT/bin/build"
"$ROOT/bin/test"

install -Dm755 "$ROOT/build/oma_spend" "$BIN/oma_spend"
install -Dm644 "$ROOT/data/oma_spend.svg" "$SHARE/icons/hicolor/scalable/apps/oma_spend.svg"

# The launcher may not have ~/.local/bin on its PATH, so point the entry at
# the binary directly.
mkdir -p "$SHARE/applications"
sed "s|^Exec=oma_spend|Exec=$BIN/oma_spend|" "$ROOT/data/oma_spend.desktop" > "$SHARE/applications/oma_spend.desktop"
chmod 644 "$SHARE/applications/oma_spend.desktop"

if command -v update-desktop-database >/dev/null; then
    update-desktop-database -q "$SHARE/applications" || true
fi
if command -v gtk-update-icon-cache >/dev/null; then
    gtk-update-icon-cache -q -t "$SHARE/icons/hicolor" 2>/dev/null || true
fi

echo "Installed $BIN/oma_spend"
